        android:pathData="M37.5,27 L70.5,27 C72,31 73,36 73,41 C73,51 66,59 54,59 C42,59 35,51 35,41 C35,36 36,31 37.5,27 Z M52,57 L56,57 L56,79 L52,79 Z"
        android:fillColor="#FFFFFFFF" />

